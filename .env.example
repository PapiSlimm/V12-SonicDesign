# Copy this file to .env.local and fill in your key. .env.local is git-ignored.
#
# VITE_GEMINI_API_KEY: LOCAL DEV ONLY. Used by the AI features (Generative Fill, Sky Replacement, Enhance, AI Animator)
# when no VITE_MEDIA_URL is set. Never ship a key in a public build — production uses the media service's /ai proxy.
# Get a key at https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_API_KEY: legacy AI Studio name, still honoured as a fallback.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted (AI Studio injects this at runtime).
APP_URL="MY_APP_URL"

# VITE_MEDIA_URL: URL of the shared V12 media service (v12-media/, browser ingress) for MP4 export.
# Render sets this automatically from render.yaml. VITE_RENDER_WORKER_URL is still honoured as a fallback.
VITE_MEDIA_URL=""

# VITE_MEDIA_TOKEN: bearer token the static app sends to the media service (its MEDIA_INGRESS_TOKEN). Render wires it from render.yaml.
VITE_MEDIA_TOKEN=""
