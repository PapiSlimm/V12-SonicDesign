{
  "name": "@v12/media",
  "version": "1.0.0",
  "description": "V12 shared media service: encode + stream + visualize behind the shared Postgres (no inter-service HTTP). Used by SonicDesign, SonicWave, SonicStream, SonicVisual, GameWorld.",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "engines": { "node": ">=20" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./client": { "types": "./dist/client/index.d.ts", "import": "./dist/client/index.js" },
    "./analyze": { "types": "./dist/analyze/index.d.ts", "import": "./dist/analyze/index.js" },
    "./visualize": { "types": "./dist/visualize/index.d.ts", "import": "./dist/visualize/index.js" },
    "./worker": { "types": "./dist/worker/index.d.ts", "import": "./dist/worker/index.js" },
    "./sql/*": "./sql/*"
  },
  "files": ["dist", "sql", "README.md"],
  "bin": { "v12-media": "./dist/bin/service.js" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/bin/service.js",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/lib-storage": "^3.700.0",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2"
  }
}
